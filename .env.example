# Copy to .env and fill in. docker-compose overrides the infra URLs; the keys are yours.
#
# Only OPENAI_API_KEY and SERPER_API_KEY are required. Anthropic and Voyage are
# optional fallbacks -- set them and the pipeline uses them automatically if OpenAI
# is down or unset.

# --- LLM: OpenAI primary, Anthropic fallback ---
# gpt-5-nano handles both expand_tree and score_batch.
OPENAI_API_KEY=
# Optional. Reached only if OpenAI errors or has no key.
ANTHROPIC_API_KEY=
# Flip to `anthropic` to make Anthropic primary and OpenAI the fallback.
LLM_PROVIDER=openai

# --- Embeddings: Voyage primary, OpenAI fallback ---
# voyage-4-lite (first 200M tokens free, ~200 runs). Falls back to
# text-embedding-3-small (reduced to 1024 dims) if Voyage errors or has no key.
EMBED_PROVIDER=voyage
VOYAGE_API_KEY=

# --- Discovery: Serper primary, SerpApi fallback ---
# Serper. Note: num > 10 bills 2 credits, not 1, so query depth is a per-query knob.
DISCOVERY_PROVIDER=serper
SERPER_API_KEY=
# Optional fallback. Reached only if Serper errors or has no key.
SERPAPI_API_KEY=

# --- Models (OpenAI primary) ---
# gpt-5-nano for everything by default; separable so a bigger model can go on expand.
OPENAI_EXPAND_MODEL=gpt-5-nano
OPENAI_SCORE_MODEL=gpt-5-nano
OPENAI_EXPAND_EFFORT=high
OPENAI_SCORE_EFFORT=low
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Models (Anthropic fallback) ---
EXPAND_MODEL=claude-opus-4-8
SCORE_MODEL=claude-haiku-4-5
EMBED_MODEL=voyage-4-lite

# Passed explicitly everywhere: OpenAI reduces to this via `dimensions`, and Voyage's
# HF weights default to 2048 while its API defaults to 1024.
EMBED_DIMENSION=1024

# --- Budget guards ---
MAX_QUERIES_PER_RUN=400
BARRIER_MIN_COMPLETION=0.95
FRESHNESS_MONTHS=18
RECENCY_HALF_LIFE_DAYS=180

# --- Infra (compose sets these; these defaults are for running outside compose) ---
DATABASE_URL=postgresql://intent:intent@localhost:5432/intent_miner
REDIS_URL=redis://localhost:6380/0
S3_ENDPOINT=http://localhost:9002
S3_BUCKET=intent-raw
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
