# Copy to .env and fill in. docker-compose overrides the infra URLs; the keys are yours.
#
# Only OPENAI_API_KEY and SERPER_API_KEY are required. Anthropic and Voyage are
# optional fallbacks -- set them and the pipeline uses them automatically if OpenAI
# is down or unset.

# --- LLM: OpenAI primary, Anthropic fallback ---
# gpt-5-nano handles both expand_tree and score_batch.
OPENAI_API_KEY=
# Optional. Reached only if OpenAI errors or has no key.
ANTHROPIC_API_KEY=
# Flip to `anthropic` to make Anthropic primary and OpenAI the fallback.
LLM_PROVIDER=openai

# --- Embeddings: Voyage primary, OpenAI fallback ---
# voyage-4-lite (first 200M tokens free, ~200 runs). Falls back to
# text-embedding-3-small (reduced to 1024 dims) if Voyage errors or has no key.
EMBED_PROVIDER=voyage
VOYAGE_API_KEY=

# --- Discovery: Serper primary, SerpApi fallback ---
# Serper. Note: num > 10 bills 2 credits, not 1, so query depth is a per-query knob.
DISCOVERY_PROVIDER=serper
SERPER_API_KEY=
# Optional fallback. Reached only if Serper errors or has no key.
SERPAPI_API_KEY=

# --- Models (OpenAI primary) ---
# gpt-5-nano for everything by default; separable so a bigger model can go on expand.
OPENAI_EXPAND_MODEL=gpt-5-nano
OPENAI_SCORE_MODEL=gpt-5-nano
OPENAI_EXPAND_EFFORT=high
OPENAI_SCORE_EFFORT=low
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Models (Anthropic fallback) ---
EXPAND_MODEL=claude-opus-4-8
SCORE_MODEL=claude-haiku-4-5
EMBED_MODEL=voyage-4-lite

# Passed explicitly everywhere: OpenAI reduces to this via `dimensions`, and Voyage's
# HF weights default to 2048 while its API defaults to 1024.
EMBED_DIMENSION=1024

# --- Budget guards ---
MAX_QUERIES_PER_RUN=400
BARRIER_MIN_COMPLETION=0.95
FRESHNESS_MONTHS=18
RECENCY_HALF_LIFE_DAYS=180

# --- Reddit cookie jar (optional) ---
# Reddit refuses datacenter IPs at the edge. Measured with the same Playwright build,
# same Chrome UA, same flags, minutes apart: residential 200 + 12 cookies, datacenter
# 403 + 1 cookie. The client was never the problem, so no stealth tooling fixes it.
#
# Set this and ONLY the cookie mint goes through the proxy -- roughly once per 30
# fetches, never per URL, so the cheapest residential plan covers a whole run while the
# .json fetches themselves keep going out direct. Leave it empty and Reddit still works,
# SERP-only: thread title and snippet, no post body, no posted_at, no engagement.
REDDIT_MINT_PROXY=

# --- Paid agent surface (x402 / A2MCP) ---
# Only needed to sell /a2mcp/* on OKX.AI. The free /runs API works without any of it.
#
# Prices in whole USDT, decimal strings. These are the SAME numbers registered on-chain
# in the service listing -- change one and you must update the other, or the listing
# advertises a price the endpoint does not charge.
A2MCP_PRICE_CREATE_JOB=0.05
A2MCP_PRICE_JOB_STATUS=0.001
# Public https base of this service. Must match the endpoint registered on-chain.
# No trailing slash. localhost / private IPs are rejected at registration.
A2MCP_BASE_URL=

# Where the money lands. No default -- a guessed payTo collects for someone else.
X402_PAY_TO=
# 196 = X Layer, where OKX's facilitator settles and OKX subsidises gas for its
# stablecoins. That gas subsidy is what makes a 0.001 call viable at all.
X402_CHAIN_ID=196
# How long a minted challenge stays signable.
X402_TIMEOUT_SECONDS=300
# No token settings here on purpose. The `exact` scheme settles the chain's EIP-3009
# stablecoins (USD~T0 / USDG on X Layer) with no on-chain approve, and the SDK picks the
# contract, decimals and EIP-712 domain. Pinning them by hand was how the charged price
# could drift from the listed one.

# Wait for on-chain confirmation before returning the resource. Leave true: async would
# hand over a job before its payment settled, and a job is not recoverable once the
# pipeline has spent LLM and SERP credits running it.
OKX_SYNC_SETTLE=true

# --- OKX facilitator credentials ---
# The facilitator verifies a presented payment (signature + KYT screening) and settles
# it on chain. Without these three the paid surface refuses every call with a 500, by
# design: it will never serve paid work it cannot prove was paid for.
#
# Create them at https://web3.okx.com/onchainos/dev-portal/project
#   1. Open the dev portal and select (or create) your project.
#   2. Create an API key for it. The portal shows all three values.
#   3. The passphrase is chosen by you at creation time and is NOT recoverable -- if you
#      lose it the key has to be replaced, so store all three together.
#   4. The secret and passphrase are shown once. Treat them like a password: they
#      authorise settlement against your project.
#
# Never commit real values. This file is the example; .env is gitignored and stays that
# way. If any of these ever reach a commit, a log, or a chat, rotate them in the portal
# rather than hoping -- revoking is cheap, a leaked settlement credential is not.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Host port nginx proxies to. Bound on 127.0.0.1 only, never published publicly.
# The container always listens on 8000; this moves only the host side, so changing it
# means changing nginx's proxy_pass to match and nothing else.
API_PORT=8001

# --- Infra ---
# Ignore these when running under compose: it overrides both with the service names
# (postgres:5432 / redis:6379). They only apply when running against the stack from the
# host, e.g. `pytest`. 127.0.0.1 rather than localhost -- the ports are published on the
# IPv4 loopback, while `localhost` resolves to ::1 first and stalls before failing over.
DATABASE_URL=postgresql://intent:intent@127.0.0.1:5432/intent_miner
REDIS_URL=redis://127.0.0.1:6380/0
